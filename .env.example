# Neon Postgres (pooled connection string)
DATABASE_URL="postgres://user:password@ep-xxx-pooler.eu-west-2.aws.neon.tech/budgie?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"

# Passkey relying party. Must match the origin the app is served from.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PASSKEY_RP_ID="localhost"
PASSKEY_RP_NAME="Budgie"

# GoCardless Bank Account Data (Open Banking) - free tier, no monthly charge.
# Create an account at https://bankaccountdata.gocardless.com/
GOCARDLESS_SECRET_ID="your-secret-id"
GOCARDLESS_SECRET_KEY="your-secret-key"

# Resend (magic-link sign-in emails) - free tier, no monthly charge.
# Create an account and a verified sender at https://resend.com/
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="Budgie <sign-in@yourdomain.com>"

# Optional site-wide HTTP Basic Auth wall (apps/web/src/middleware.ts) -
# stops anonymous strangers reaching the app at all. Leave both unset for
# local dev/CI; set them on the production Netlify site only.
# SITE_AUTH_USER="budgie"
# SITE_AUTH_PASSWORD="choose-a-shared-password"
