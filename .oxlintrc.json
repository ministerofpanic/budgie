{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "react", "react-perf", "oxc", "promise"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/no-explicit-any": "error",
    "unicorn/prefer-node-protocol": "error",
    "react/react-in-jsx-scope": "off"
  },
  "ignorePatterns": [
    "**/.next/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/.turbo/**",
    "packages/db/drizzle/**"
  ],
  "overrides": [
    {
      "files": ["**/seed.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "apps/web/src/components/reports/reports-view.tsx",
        "apps/web/src/components/ui/**",
        "apps/web/src/app/layout.tsx"
      ],
      "rules": {
        "react-perf/jsx-no-new-object-as-prop": "off"
      }
    }
  ]
}
